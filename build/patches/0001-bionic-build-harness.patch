+// Run vite with spawnSync rather than a shell. This module imports `effect`,
+// whose runtime keeps Bun's event loop alive under Termux; a shell promise then
+// never observes the child exiting and the whole CLI build hangs after vite has
+// already printed "built in". spawnSync blocks until the child truly exits.
+// The child is `vite-build.mjs`, which drives vite's build() API and force-exits
+// because the plain `vite build` CLI does not exit in this environment either.
+function buildVite(root: string, channel: string) {
+  const result = spawnSync("node", ["vite-build.mjs"], {
+    cwd: root,
+    stdio: "inherit",
+    env: { ...process.env, OPENCODE_CHANNEL: channel, VITE_OPENCODE_SERVER_MODE: "origin" },
+  })
+  if (result.status !== 0) throw new Error(`vite build failed with status ${result.status}`)
+}
